# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Re-fetchable raw training data cache (scripts/ml/train.py repopulates this
# from GitHub/Wikipedia on a clean run) — the trained model artifacts that
# actually ship with the app live in server/ml/*.json, not here.
scripts/ml/cache/

# Live SQLite runtime data — schema, migrations, and seed/reset scripts are
# tracked; the actual database is created and re-seeded automatically on first
# run (see server/db.ts, npm run db:reset), so there's nothing to commit here.
data/wsl.db
*.db-wal
*.db-shm

# Local secrets (GROQ_API_KEY / GEMINI_API_KEY etc.) — never committed.
.env
# Playwright CLI page snapshots and review screenshots — local debugging output, never part of the app.
.playwright-cli/
review2-*.png
